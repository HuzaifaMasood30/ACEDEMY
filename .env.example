# ---------------------------------------------------------------------------
# Academy ERP — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://academy:academy_dev_pw@127.0.0.1:5432/academy_erp?schema=public"

# --- Application ------------------------------------------------------------
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Wisdom Academy"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-openssl-rand-base64-48"
AUTH_TRUST_HOST="true"
# Session lifetime in seconds (default 8 hours)
SESSION_MAX_AGE="28800"
# Login throttling
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"

# --- Academy defaults -------------------------------------------------------
ACADEMY_NAME="Wisdom Academy"
ACADEMY_TIMEZONE="Asia/Karachi"
ACADEMY_CURRENCY="PKR"
ACADEMY_LOCALE="en"

# --- File storage -----------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR. "s3" uses the S3_* variables below.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
STORAGE_MAX_FILE_MB="10"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- WhatsApp Business Platform (Cloud API) ---------------------------------
# mode: "mock"  -> nothing leaves the machine; messages are recorded as simulated
#       "cloud" -> real delivery through the official WhatsApp Cloud API
WHATSAPP_MODE="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_BASE="https://graph.facebook.com"
# Academy default sending language and quiet-hours window (24h local minutes)
WHATSAPP_DEFAULT_LOCALE="en"
WHATSAPP_QUIET_HOURS_START="21:00"
WHATSAPP_QUIET_HOURS_END="07:00"
WHATSAPP_RATE_LIMIT_PER_MINUTE="60"

# --- Background worker ------------------------------------------------------
WORKER_POLL_INTERVAL_MS="5000"
WORKER_BATCH_SIZE="25"
WORKER_MAX_ATTEMPTS="4"
WORKER_CONCURRENCY="4"

# --- Seeding ----------------------------------------------------------------
# Password applied to every seeded demo account. Development only.
SEED_DEFAULT_PASSWORD="Academy@123"
